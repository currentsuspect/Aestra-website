# Server-side only. Configure these in Vercel Project Settings -> Environment Variables.
# Must be a Resend Full access key because the waitlist persists Contacts before sending.
RESEND_API_KEY=re_xxxxxxxxx

# Optional overrides. Defaults shown below.
WAITLIST_NOTIFY_TO=hello@aestra.studio
RESEND_FROM=Aestra <hello@aestra.studio>
