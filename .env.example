# Server-side only. Configure these in Vercel Project Settings -> Environment Variables.
# Must be a Resend Full access key because the waitlist manages Contacts and Segments.
RESEND_API_KEY=re_xxxxxxxxx

# Create these three Segments in Resend and paste their IDs here.
RESEND_SEGMENT_EARLY_ACCESS=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
RESEND_SEGMENT_SUPPORTER=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
RESEND_SEGMENT_FOUNDER=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Optional overrides. Defaults shown below.
WAITLIST_NOTIFY_TO=hello@aestra.studio
RESEND_FROM=Aestra <hello@aestra.studio>
